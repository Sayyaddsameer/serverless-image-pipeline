# AWS Configuration (for real AWS deployment)
AWS_REGION=us-east-1
AWS_PROFILE=default

# Application Configuration
TARGET_WIDTH=200
WATERMARK_TEXT=(c) MyCompany

# Resource Names (auto-generated during deployment)
INPUT_BUCKET_NAME=input-image-bucket-dev-v1
PROCESSED_BUCKET_NAME=processed-image-bucket-dev-v1
SQS_QUEUE_URL=
DLQ_QUEUE_URL=
DYNAMODB_TABLE_NAME=ImageMetadataTable

# LocalStack Configuration
LOCALSTACK_HOST=localstack_main
AWS_ENDPOINT_URL=http://localhost:4566
DEBUG=0
LOCALSTACK_VOLUME_DIR=./localstack/volume

# Testing
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
